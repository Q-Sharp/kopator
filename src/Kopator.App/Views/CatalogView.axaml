<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kopator.App.ViewModels"
             xmlns:conv="using:Kopator.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="200"
             x:Class="Kopator.App.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">

    <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="20,18" VerticalAlignment="Top">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Quelle" />
        <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding Source}"
                 PlaceholderText="Ordner, der katalogisiert wird" />
        <Button Grid.Row="0" Grid.Column="2" Classes="browse" Content="…"
                Command="{Binding BrowseSourceCommand}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Zieldatei" Margin="0,12,12,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding DestinationFile}"
                 PlaceholderText="Datei, in die der Katalog geschrieben wird" Margin="0,12,0,0" />
        <Button Grid.Row="1" Grid.Column="2" Classes="browse" Content="…" Margin="8,12,0,0"
                Command="{Binding BrowseDestinationFileCommand}" />

        <!-- File type and export format are short values and share a row. -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
              ColumnDefinitions="90,140,Auto,*" Margin="0,14,0,0">

            <TextBlock Grid.Column="0" Classes="field" Text="Dateityp" />
            <TextBox Grid.Column="1" Classes="field" Text="{Binding FileType}" PlaceholderText="alle" />

            <TextBlock Grid.Column="2" Classes="field" Text="Format" Margin="24,0,12,0" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding ExportTypes}"
                      SelectedItem="{Binding ExportType}"
                      Height="34"
                      HorizontalAlignment="Left" MinWidth="120">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static conv:ExportTypeNameConverter.Instance}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

        </Grid>

    </Grid>

</UserControl>
