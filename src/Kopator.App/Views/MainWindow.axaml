<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kopator.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="420"
        x:Class="Kopator.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/cpsuisam.ico"
        Title="kopator"
        Width="780" Height="420"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="*,Auto,Auto" Margin="12" >

        <HeaderedContentControl Grid.Row="0" Header="Pfadangaben">
            <TabControl ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab}"
                        IsEnabled="{Binding IsIdle}"
                        Margin="0,4,0,0">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="vm:OperationViewModel">
                        <TextBlock Text="{Binding Header}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </HeaderedContentControl>

        <HeaderedContentControl Grid.Row="1" Header="Fortschritt" Margin="0,12,0,0">
            <ProgressBar Value="{Binding Progress}"
                         Maximum="{Binding ProgressMaximum}"
                         IsEnabled="{Binding IsProcessing}"
                         Height="24"
                         Margin="0,4,0,0" />
        </HeaderedContentControl>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0"
                    Content="Schließen"
                    MinWidth="120"
                    IsEnabled="{Binding IsIdle}"
                    Command="{Binding CloseCommand}" />

            <CheckBox Grid.Column="2"
                      Content="Verschieben?"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      IsChecked="{Binding Move}"
                      IsEnabled="{Binding IsMoveEnabled}" />

            <Button Grid.Column="3"
                    Content="{Binding ActionLabel}"
                    MinWidth="140"
                    IsDefault="True"
                    Command="{Binding ExecuteCommand}" />
        </Grid>

    </Grid>

</Window>
