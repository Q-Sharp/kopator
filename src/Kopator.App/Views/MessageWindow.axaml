<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="160"
        x:Class="Kopator.App.Views.MessageWindow"
        Icon="/Assets/cpsuisam.ico"
        SizeToContent="WidthAndHeight"
        MinWidth="320" MaxWidth="560"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="20">
        <TextBlock Name="MessageText" TextWrapping="Wrap" MaxWidth="500" />
        <Button Name="OkButton" Content="OK" MinWidth="100"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
    </StackPanel>

</Window>
